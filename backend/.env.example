# Backend environment (Railway variables). Copy values into Railway; never commit real secrets.
# Full list and meaning: docs/DEPLOYMENT-RUNBOOK.md §4
SPRING_PROFILES_ACTIVE=staging

PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGDATABASE=${{Postgres.PGDATABASE}}
# Owner role used only by Flyway migrations
DB_MIGRATION_USER=${{Postgres.PGUSER}}
DB_MIGRATION_PASSWORD=${{Postgres.PGPASSWORD}}
# Restricted runtime role (created automatically after migration; RLS applies to it)
DB_APP_USER=pos_app_login
DB_APP_PASSWORD=<generate a long random password>

# Web app
APP_ROOT_DOMAIN=staging.selectcodepos.com
APP_WEB_SCHEME=https
APP_CORS_ALLOWED_ORIGINS=https://staging.selectcodepos.com,https://admin.staging.selectcodepos.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.staging.selectcodepos.com
APP_COOKIE_DOMAIN=.staging.selectcodepos.com

# First super admin (remove after the first sign-in)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Email: either an API (brevo or resend) ...
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=no-reply@selectcodepos.com
# ... or SMTP
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Files (Cloudflare R2), from Stage 5
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
