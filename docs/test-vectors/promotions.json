{
  "_about": "Offers and coupons (SUP-05, XSL-02). Shared by backend (PromotionEngineTest) and frontend (promotions.test.ts). Item offers apply only to eligible lines (base unit, list price, no typed discount); the best offer per line wins (older offer on a tie); bill offers apply to the bill after line discounts when no bill discount was typed; coupon offers need their code.",
  "lineAmount": [
    { "name": "percent off", "offer": { "kind": "PERCENT", "value": "10.00" }, "qty": "3.000", "price": "99.99", "expected": "30.00" },
    { "name": "amount off each, weighed", "offer": { "kind": "AMOUNT", "value": "15.00" }, "qty": "1.250", "price": "180.00", "expected": "18.75" },
    { "name": "amount off never more than the line", "offer": { "kind": "AMOUNT", "value": "500.00" }, "qty": "1.000", "price": "120.00", "expected": "120.00" },
    { "name": "buy 2 get 1 free, 7 bought", "offer": { "kind": "BUY_GET", "buyQty": "2.000", "getQty": "1.000" }, "qty": "7.000", "price": "50.00", "expected": "100.00" },
    { "name": "buy 2 get 1 free, 2 bought", "offer": { "kind": "BUY_GET", "buyQty": "2.000", "getQty": "1.000" }, "qty": "2.000", "price": "50.00", "expected": "0.00" },
    { "name": "3 for Rs 250, 7 bought", "offer": { "kind": "MULTI_PRICE", "buyQty": "3.000", "value": "250.00" }, "qty": "7.000", "price": "95.00", "expected": "70.00" },
    { "name": "multi price dearer than normal gives nothing", "offer": { "kind": "MULTI_PRICE", "buyQty": "2.000", "value": "300.00" }, "qty": "2.000", "price": "100.00", "expected": "0.00" }
