    { "name": "below the minimum", "offer": { "kind": "BILL_PERCENT", "value": "5.00", "minAmount": "1000.00" }, "bill": "999.99", "expected": "0.00" },
    { "name": "Rs 100 off", "offer": { "kind": "BILL_AMOUNT", "value": "100.00", "minAmount": "500.00" }, "bill": "500.00", "expected": "100.00" }
